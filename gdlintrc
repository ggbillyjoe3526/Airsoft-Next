# gdlint settings (gdtoolkit 4.5.0, run by CI and tools/check.sh). Checks naming, unused arguments, whitespace and
# dead code. The layout rules (line length, member order, file and function size) are off: they don't catch bugs.
disable:
- class-definitions-order
- max-line-length
- max-file-lines
- max-public-methods
- max-returns
# Single capital letters are allowed for maths shorthand (L for length, R for radius).
function-variable-name: '([a-z][a-z0-9]*(_[a-z0-9]+)*|[A-Z])'
excluded_directories: !!set
  .git: null
  .godot: null
  addons: null
  legacy: null
